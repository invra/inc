+    // A fullscreen window that is opening starts below a panel and grows into place. Its presented
+    // box covers the output only once the animation ends, which leaves top-layer panels over it for
+    // the whole transition. A settled, unscrolled workspace already has the fullscreen target box on
+    // the output, so use that to raise the window immediately. Scrolling and sliding workspaces keep
+    // following the presented box, so a window that is leaving stays beneath panels until it is gone.
+    const wlr_scene_tree* fullscreenTree = workspace->fullscreenTree();
+    const bool settled = fullscreenTree == nullptr
+        || (fullscreenTree->node.x == 0 && fullscreenTree->node.y == 0);
+    const bool scrolling = workspace->scrollingLayout() != nullptr;
+    return std::ranges::any_of(workspace->allViews(), [&](const View* view) {
+      if (!view->mapped() || !(view->layoutFullscreen() || view->currentFullscreen()) || !view->presented()) {
+        return false;
+      }
+      if (covers(view->presentedBox())) {
